<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/quest"
        android:layout_width="80dp"
        android:layout_height="86dp"
        android:layout_marginTop="16dp"
        android:text="+"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        android:contentDescription="Create new quest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/inventory"
        android:layout_width="132dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="40dp"
        android:text="Inventory"
        android:textAlignment="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:contentDescription="View inventory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bosshistory"
        android:layout_width="132dp"
        android:layout_height="48dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="10dp"
        android:text="Boss History"
        android:textAlignment="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:contentDescription="View boss history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Create Quest!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Create Quest section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inventory" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="428dp"
        android:layout_height="125dp"
        android:contentDescription="Landscape image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quest"
        app:srcCompat="@drawable/landscape" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="120dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="172dp"
        android:contentDescription="Player avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/player" />

    <ImageView
        android:id="@+id/enemyImageView"
        android:layout_width="121dp"
        android:layout_height="111dp"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Enemy avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cloudman" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quest List"
        android:textAlignment="textStart"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Quest List section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <ScrollView
        android:layout_width="411dp"
        android:layout_height="438dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Scrollable list of quests"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <LinearLayout
            android:id="@+id/questContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/healthTextView"
        android:layout_width="87dp"
        android:layout_height="27dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="2dp"
        android:text="Health: 100"
        android:textSize="16sp"
        android:textStyle="bold"
        android:contentDescription="Enemy health"
        app:layout_constraintBottom_toTopOf="@+id/healthProgressBar"
        app:layout_constraintStart_toEndOf="@+id/quest" />

    <ProgressBar
        android:id="@+id/healthProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="147dp"
        android:layout_height="15dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:indeterminate="false"
        android:max="100"
        android:min="0"
        android:progress="100"
        android:progressDrawable="@drawable/health_bar_drawable"
        app:layout_constraintBottom_toTopOf="@+id/enemyImageView"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
